# Supabase project URL and anon (publishable) key.
# Safe to expose to the browser — required at BUILD time because Next.js
# inlines NEXT_PUBLIC_* vars into the client bundle. See README "Deploy on
# Coolify" for how to pass these as Docker build args.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# There is deliberately no service-role key here. Operations needing elevated
# privilege are SECURITY DEFINER Postgres functions with narrow signatures,
# never a key handed to a server action — one forgotten company_id filter
# would leak every tenant. See SPEC.md §4.4.

# Invitation email delivery (BLOCKERS.md N-6). All three optional: unset,
# createInvitation() still works — it just doesn't send an email, and the
# admin gets the copyable link instead (same fallback the template used
# before this was wired up).
#
# Get RESEND_API_KEY from https://resend.com/api-keys. For real delivery,
# EMAIL_FROM must be an address on a domain you've verified with Resend —
# without a verified domain, Resend only accepts EMAIL_FROM=onboarding@resend.dev
# and only delivers to the account's own signup email (sandbox mode).
RESEND_API_KEY=
EMAIL_FROM=Timey <invitations@your-domain.com>

# The origin used to build the invite link inside the email — a server can't
# read this from the browser the way the on-screen copy link does. No
# trailing slash.
APP_URL=http://127.0.0.1:3000
