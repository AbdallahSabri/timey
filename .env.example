# Supabase project URL and anon (publishable) key.
# Safe to expose to the browser — required at BUILD time because Next.js
# inlines NEXT_PUBLIC_* vars into the client bundle. See README "Deploy on
# Coolify" for how to pass these as Docker build args.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key — NEVER prefix with NEXT_PUBLIC_, never sent
# to the browser, never baked into the Docker image. Injected at container
# runtime by Coolify. Only needed if a server action/route requires
# bypassing Row Level Security (RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
